{
	email 403010@qq.com
	auto_https disable_redirects
}

(common) {
	encode gzip zstd
	header Access-Control-Allow-Origin "*"
	header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
	header Access-Control-Allow-Headers "*"

	@node path /__bluecdn_node
	handle @node {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8099
	}

	@opt method OPTIONS
	respond @opt 204

	@jsd path /npm/* /gh/* /wp/* /combine/* /esm/*
	handle @jsd {
		reverse_proxy https://cdn.jsdelivr.net {
			header_up Host cdn.jsdelivr.net
			header_down Location "https://cdn\.jsdelivr\.net/" "https://static.bluecdn.com/"
		}
		header Cache-Control "public, max-age=31536000, immutable"
	}
	@cdnjs path /ajax/libs/*
	handle @cdnjs {
		reverse_proxy https://cdnjs.cloudflare.com {
			header_up Host cdnjs.cloudflare.com
			header_down Location "https://cdnjs\.cloudflare\.com/" "https://static.bluecdn.com/"
		}
		header Cache-Control "public, max-age=31536000, immutable"
	}
	handle {
		root * /www/sites/static.bluecdn.com
		@imm path *.woff2 *.woff
		header @imm Cache-Control "public, max-age=31536000, immutable"
		@short path *.css *.html /
		header @short Cache-Control "public, max-age=300, must-revalidate"
		file_server
	}
}

:80 {
	import common
}

# static 源站(CF 回源,自签证书);具名以免 catch-all 抢占其他域名的 SNI
static.bluecdn.com static-edge.bluecdn.com origin-sh.bluecdn.com {
	tls /etc/caddy/origin.crt /etc/caddy/origin.key
	import common
}

# ===== LiteAvatar gravatar 服务 =====
# 给上海等被墙节点当 gravatar 中转(反代 gravatar.com)
gravatar-us.bluecdn.com {
	encode gzip zstd
	header Access-Control-Allow-Origin "*"
	reverse_proxy https://secure.gravatar.com {
		header_up Host secure.gravatar.com
	}
}

# Cloudflare 回源入口 → LiteAvatar(:8787)
gravatar-origin-us.bluecdn.com {
	encode gzip zstd
	header Access-Control-Allow-Origin "*"
	reverse_proxy 127.0.0.1:8787
}

# CDN 回源时 HTTP Host=gravatar.bluecdn.com,需显式站点块匹配(证书用 acme.sh DNS-01 签的)
gravatar.bluecdn.com {
	tls /etc/caddy/certs/gravatar.fullchain.pem /etc/caddy/certs/gravatar.key
	encode gzip zstd
	header Access-Control-Allow-Origin "*"
	reverse_proxy 127.0.0.1:8787
}
