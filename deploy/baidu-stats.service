# /etc/systemd/system/baidu-stats.service
# 由 baidu-stats.timer 每小时触发，拉取百度 CDN 累计请求数。
[Unit]
Description=LiteAvatar Baidu CDN stats fetcher

[Service]
Type=oneshot
User=caddy
Group=caddy
# 凭证与统计参数从 .env 加载（BAIDU_AK/BAIDU_SK/BAIDU_STAT_*）
EnvironmentFile=/opt/gravatar-proxy/.env
ExecStart=/opt/gravatar-proxy/baidu-stats.py
