# /etc/systemd/system/gravatar-proxy.service
[Unit]
Description=LiteAvatar multi-source avatar proxy (Go)
After=network.target

[Service]
Type=simple
User=caddy
Group=caddy
WorkingDirectory=/opt/gravatar-proxy
# CDN 分发统一使用阿里云 ESA；服务只读取后台脚本写入的累计值。
ExecStart=/opt/gravatar-proxy/gravatar-proxy -listen 127.0.0.1:8787 -counter /opt/gravatar-proxy/stats/requests.count -site-dir /opt/gravatar-proxy -gravatar-upstream https://secure.gravatar.com -cache-dir /opt/gravatar-proxy/cache -cache-ttl 168h -esa-counter /opt/gravatar-proxy/stats/esa.count
Restart=on-failure
RestartSec=2
LimitNOFILE=65535
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
