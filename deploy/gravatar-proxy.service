# /etc/systemd/system/gravatar-proxy.service
[Unit]
Description=LiteAvatar multi-source avatar proxy (Go)
After=network.target

[Service]
Type=simple
User=caddy
Group=caddy
WorkingDirectory=/opt/gravatar-proxy
# CDN 统计凭证从 env 文件加载（/opt/gravatar-proxy/.env，不入 git）
EnvironmentFile=/opt/gravatar-proxy/.env
ExecStart=/opt/gravatar-proxy/gravatar-proxy -listen 127.0.0.1:8787 -counter /opt/gravatar-proxy/requests.count -gravatar-upstream https://secure.gravatar.com -cache-dir /opt/gravatar-proxy/cache -cache-ttl 168h
Restart=on-failure
RestartSec=2
LimitNOFILE=65535
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
