# /etc/systemd/system/gravatar-proxy.service
[Unit]
Description=Gravatar avatar proxy (Go)
After=network.target

[Service]
Type=simple
User=caddy
Group=caddy
WorkingDirectory=/opt/gravatar-proxy
ExecStart=/opt/gravatar-proxy/gravatar-proxy
Restart=on-failure
RestartSec=2
LimitNOFILE=65535
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
