# LiteAvatar CDN 统计凭证 —— 部署到服务器时复制为 .env 并填入真值（.env 不入 git）。
# 用于 /stats 页脚统计：本地请求数 + Bunny CDN 请求数 + 百度 CDN 请求数。

# Bunny CDN: https://dash.bunny.net → Account Settings → API Settings
BUNNY_API_KEY=

# Pull Zone ID（gravatar 的拉取区，dash.bunny.net → Pull Zones 里查看）
BUNNY_PULLZONE_ID=

# Pull Zone 创建日（用于拉取累计总请求数，格式 YYYY-MM-DD）
BUNNY_ZONE_START=2026-06-07

# 百度智能云 CDN
BAIDU_AK=
BAIDU_SK=
BAIDU_STAT_DOMAIN=gravatar.bluecdn.com
BAIDU_STAT_START=2026-06-07
BAIDU_STAT_METRIC=pv
